{
	"name": "pi-mdtools",
	"version": "0.1.0",
	"description": "Pi extension exposing mdtools structural Markdown reads and safe mutation macros.",
	"author": "pro-vi",
	"license": "MIT",
	"type": "module",
	"main": "./index.ts",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"markdown",
		"mdtools"
	],
	"files": [
		"index.ts",
		"src",
		"README.md",
		"LICENSE",
		"package.json"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node --import=tsx --test test/*.test.ts",
		"smoke-test": "PI_OFFLINE=1 PI_SKIP_VERSION_CHECK=1 pi --no-extensions --no-skills --no-prompt-templates --no-themes --no-context-files -e ./index.ts -p '/mdtools status'",
		"check": "npm run typecheck && npm run test && npm run smoke-test",
		"test:parity": "node --import=tsx --test test/integration.parity.test.ts"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.80.2",
		"@earendil-works/pi-coding-agent": "^0.80.2",
		"@types/node": "^24.12.4",
		"tsx": "^4.21.0",
		"typebox": "^1.1.38",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	}
}
